# Application Configuration
NODE_ENV=development
PORT=3000
BASE_PATH=/api/v1
DEX_KEY=hydration
DEFAULT_CHAIN_ID=1

# Feature Flags
ENABLE_CORS=true
ENABLE_SWAGGER=true
ENABLE_METRICS=false
ENABLE_HEALTH_CHECK=true
ENABLE_TYPED_GRAPHQL=true
ENABLE_DEBUG_LOGGING=false

# Performance Configuration
API_CACHE_TTL_MS=600000
REQUEST_TIMEOUT_MS=30000
MAX_BLOCK_RANGE=1000
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# Logging
LOG_LEVEL=info

# GraphQL API Configuration
MAIN_INDEXER_GRAPHQL_ENDPOINT=https://api.example.com/graphql
GRAPHQL_API_KEY=your_api_key_here
GRAPHQL_REQUEST_TIMEOUT_MS=30000
GRAPHQL_MAX_RETRY_ATTEMPTS=3
GRAPHQL_RETRY_DELAY_MS=1000
GRAPHQL_MAX_RETRY_DELAY_MS=15000

# Multiple GraphQL Endpoints (optional - defaults to MAIN_INDEXER_GRAPHQL_ENDPOINT if not specified)
GRAPHQL_HISTORICAL_ENDPOINT=https://historical.api.example.com/graphql
GRAPHQL_ANALYTICS_ENDPOINT=https://analytics.api.example.com/graphql
GRAPHQL_PAIRS_ENDPOINT=https://pairs.api.example.com/graphql
GRAPHQL_ASSETS_ENDPOINT=https://assets.api.example.com/graphql
GRAPHQL_EVENTS_ENDPOINT=https://events.api.example.com/graphql

# Database Configuration (if needed in future)
DB_HOST=localhost
DB_NAME=hydration_adapter
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432
DB_SSL_MODE=prefer
DB_CONNECTION_TIMEOUT_MS=30000
DB_MAX_CONNECTIONS=20
DB_LOGGING=false
