# GraphQL API Configuration
MAIN_INDEXER_GRAPHQL_ENDPOINT=https://api.example.com/graphql
GRAPHQL_API_KEY=your_api_key_here

# Multiple GraphQL Endpoints (optional - defaults to MAIN_INDEXER_GRAPHQL_ENDPOINT if not specified)
GRAPHQL_HISTORICAL_ENDPOINT=https://historical.api.example.com/graphql
GRAPHQL_ANALYTICS_ENDPOINT=https://analytics.api.example.com/graphql
GRAPHQL_PAIRS_ENDPOINT=https://pairs.api.example.com/graphql
GRAPHQL_ASSETS_ENDPOINT=https://assets.api.example.com/graphql
GRAPHQL_EVENTS_ENDPOINT=https://events.api.example.com/graphql

# Application Configuration
PORT=8080
NODE_ENV=development

# DEX Configuration
DEX_KEY=hydration
DEFAULT_CHAIN_ID=1
