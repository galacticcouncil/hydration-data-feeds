# Application
NODE_ENV=development
PORT=3000

# Database (TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hydration_charts
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GraphQL Endpoint
GRAPHQL_ENDPOINT=https://galacticcouncil.squids.live/hydration-pools:orca-prod/api/graphql

# Ingestion Configuration (Swaps)
INGESTION_START_BLOCK=9999990
INGESTION_BATCH_SIZE=100
INGESTION_INTERVAL_SECONDS=60
INGESTION_BACKFILL_ON_STARTUP=true

# Money Market Configuration (Liquidations)
MONEY_MARKET_START_BLOCK=121
MONEY_MARKET_BATCH_SIZE=100
MONEY_MARKET_INTERVAL_SECONDS=60
MONEY_MARKET_BACKFILL_ON_STARTUP=true

# PEPL Liquidation Configuration
PEPL_LIQUIDATION_START_BLOCK=1000000
PEPL_LIQUIDATION_BATCH_SIZE=500
PEPL_LIQUIDATION_INTERVAL_SECONDS=300
PEPL_LIQUIDATION_BACKFILL_ON_STARTUP=true

# Asset Reserve Configuration
ASSET_RESERVE_START_BLOCK=1000000
ASSET_RESERVE_BATCH_SIZE=500
ASSET_RESERVE_INTERVAL_SECONDS=300
ASSET_RESERVE_BACKFILL_ON_STARTUP=true

# Borrow APR Configuration
BORROW_APR_START_BLOCK=1000000
BORROW_APR_BATCH_SIZE=500
BORROW_APR_INTERVAL_SECONDS=300
BORROW_APR_BACKFILL_ON_STARTUP=true

# HSM Revenue Configuration
HSM_REVENUE_START_BLOCK=1000000
HSM_REVENUE_BATCH_SIZE=100
HSM_REVENUE_INTERVAL_SECONDS=300
HSM_REVENUE_BACKFILL_ON_STARTUP=true

# Enrichment Configuration
ENRICHMENT_BATCH_SIZE=1000
ENRICHMENT_INTERVAL_SECONDS=120
ENRICHMENT_MAX_RETRIES=3

# Asset Registry Configuration
ASSET_REGISTRY_REFRESH_INTERVAL=43200  # 12 hours (in-memory cache only)

# Caching (TTL in seconds)
CACHE_TTL_1MIN=60
CACHE_TTL_1HOUR=300
CACHE_TTL_1DAY=600

# API Configuration
API_PORT=3000
API_PUBLIC=true
API_TIMEZONE=UTC

GRAPHQL_ENDPOINTS="
4000001|4500000|https://url.com/graphql
4500001|5000000|https://url.com/graphql
5000001|5500000|https://url.com/graphql
11000001|-1|https://url.com/graphql
"